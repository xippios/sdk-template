"""Refresh the packaged reference data from upstream (``/refresh-reference-data``).

The source declares its lists in ``LISTS``, one ``Listed`` each, with the wrapper in
``api/`` that fetches it, never a task that answers from the package, and names each in
``params.PACKAGED_LISTS``; core's frame, ``xippios.core.refresh``, does the rest
(sdk-core ADR-0051). It fetches every list before it writes one, through the package's
client with one attempt per request, so a 5xx or a 429 spends no second call of
upstream's quota, and prints the requests it sent and the quota left in
``QUOTA_HEADER``, a failed run's too, a request that ended in a transport error counted
as sent. Then it writes each ``reference/<name>.json`` by ``PackagedList.write``, the
list's row of the provenance table in ``reference/README.md`` and ``enums.py``, one
``render_enums`` call formatted by ``ruff format`` and ``ruff check --fix``
(sdk-core ADR-0031), as one: a run that fails writes nothing and is run again.

Only lists that are the same for every caller are packaged; a multi-tenant source
packages no tenant data (sdk-core ADR-0036). Run from the repository root, with whatever
the list endpoints need in the environment (a key only where they take one)::

    uv run python scripts/refresh_reference.py                     # fetch every list
    uv run python scripts/refresh_reference.py --only commodities  # one list, the rest kept
    uv run python scripts/refresh_reference.py --render-only       # no request, no key

``--render-only`` writes ``enums.py`` and the rows from the packaged files alone, as an
adoption does after a core release changes the renderer (conventions §15, item 6).
"""

{% if tenant_param %}
import sys
{% endif %}
from collections.abc import Sequence

{% if tenant_param %}
from xippios.core import AsyncClient
{% endif %}
from xippios.core.refresh import Listed, run

{% if tenant_param %}
from xippios.{{ import_path }}._client import DEMO, client_for, config
{% else %}
from xippios.{{ import_path }}._client import client
{% endif %}
from xippios.{{ import_path }}.params import PACKAGE, PACKAGED_LISTS

QUOTA_HEADER: str | None = "x-ratelimit-remaining"
"""The response header in which upstream reports the requests left in its quota, as its
documentation names it, or ``None`` where it reports none."""

LISTS: tuple[Listed, ...] = (
    # One Listed per list of params.PACKAGED_LISTS, in the order of their enums in
    # enums.py; import Enumeration from xippios.core.refresh beside Listed, and api from
    # the package, with the first list that takes them. A list of values, packaged as
    # records of one field named by the list, makes a StrEnum:
    # Listed(
    #     "state_alpha",
    #     lambda: api.get_param_values("state_alpha"),
    #     endpoint="get_param_values",
    #     enum=Enumeration(),
    # ),
    # A list of integer ids and names, packaged as upstream's records, makes an IntEnum
    # named after its id field, unitId making UnitId:
    # Listed(
    #     "unitsOfMeasure",
    #     api.get_units_of_measure,
    #     endpoint="GetUnitsOfMeasure",
    #     enum=Enumeration(ids="unitId", names="unitDescription"),
    # ),
    # A table, packaged as upstream's records, makes no enum:
    # Listed("commodities", api.get_commodities, endpoint="GetCommodities"),
)
"""The packaged lists, one ``Listed`` each: its fetch, its upstream operation, its enum, if
any, and its ``origin`` where the provenance row names more than that operation."""


def main(argv: Sequence[str] | None = None) -> int:
    """Run core's frame on ``LISTS``: every list, some with ``--only``, or ``--render-only``."""
{% if tenant_param %}
    # Reference data is the same for every tenant: fetched through the reserved one's
    # client, the one the fetches send through. A run that fetches nothing, --render-only
    # or --help, needs none of its variables, so it gets a client of no tenant, unused.
    arguments = sys.argv[1:] if argv is None else list(argv)
    fetches = not {"--render-only", "-h", "--help"} & set(arguments)
{% endif %}
    return run(
        LISTS,
{% if tenant_param %}
        arguments,
{% else %}
        argv,
{% endif %}
        package=PACKAGE,
        packaged=PACKAGED_LISTS,
{% if tenant_param %}
        client=client_for(DEMO) if fetches else AsyncClient(config),
{% else %}
        client=client,
{% endif %}
        quota_header=QUOTA_HEADER,
    )


if __name__ == "__main__":
    raise SystemExit(main())
