class AuthReport(NamedTuple):
    """What a request through the client's auth carried, as booleans: never a value."""

    env_holds_placeholder: bool
    carries_placeholder: bool
    carries_shell_key: bool
    where: str


def send_through_auth(placeholder: str) -> AuthReport:
    """Run a request through the client's auth and report on it, never with a value.

    The request, its URL and its headers stay in this frame, which has returned before the
    test asserts: a failure, even under ``pytest -l``, cannot print the shell's key.
    """
    env_holds_placeholder = os.environ.get(API_KEY_ENV) == placeholder
    sent = next(auth.sync_auth_flow(httpx.Request("GET", BASE_URL)))
{% if api_key_location == 'query' %}
    carried = sent.url.params.get(auth.param, "")
    where = f"the {auth.param} query parameter"
{% elif api_key_location == 'header' %}
    carried = sent.headers.get(auth.header, "")
    where = f"the {auth.header} header"
{% elif api_key_location == 'bearer' %}
    carried = sent.headers.get("Authorization", "").removeprefix("Bearer ")
    where = "the bearer Authorization header"
{% else %}
    encoded = sent.headers.get("Authorization", "").removeprefix("Basic ")
    carried = base64.b64decode(encoded).decode().partition(":")[0]
    where = "the basic auth user name"
{% endif %}
    carries_shell_key = False
    if SHELL_KEY and placeholder != SHELL_KEY:
        outgoing = [str(sent.url), *sent.headers.values(), carried]
        carries_shell_key = any(SHELL_KEY in part for part in outgoing)
    return AuthReport(env_holds_placeholder, carried == placeholder, carries_shell_key, where)


def test_replay_tests_send_the_placeholder_key(placeholder_api_key: str | None) -> None:
    """A request sent outside a live test carries the placeholder, never the shell's key.

    Every assertion is on a boolean, so a failure says where the key went, never the key.
    """
    assert placeholder_api_key is not None
    report = send_through_auth(placeholder_api_key)
    assert report.env_holds_placeholder, f"{API_KEY_ENV} does not hold the placeholder"
    assert report.carries_placeholder, f"{report.where} does not carry the placeholder"
    assert not report.carries_shell_key, f"the key in {API_KEY_ENV} went out with the request"
{% endif %}


@pytest.mark.parametrize("task", TASKS, ids=tasks.__all__)
def test_task_is_a_sync_facade_with_an_agent_docstring(task: object) -> None:
    assert callable(task)
    assert hasattr(task, "async_fn"), "write the async function and derive the sync one with sync()"
    doc = inspect.getdoc(task) or ""
    assert doc, "task functions need a docstring: agents read it"
    assert doc.splitlines()[0].endswith("."), "the first line is one sentence"
    if inspect.signature(task).parameters:
        assert "Args:" in doc, "explain every parameter under Args: with valid-value examples"
