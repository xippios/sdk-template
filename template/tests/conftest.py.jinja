{% if tenant_param %}
from xippios.core.testing import keep_reserved_tenants

from xippios.{{ import_path }}._client import TENANTS

{% endif %}
{% if key_envs %}
# Core's plugin keeps the default run offline and free of real keys (ADR-0013), runs anyio
# tests on asyncio and serves the family check in tests/test_family.py; a key's variable is
# named under xippios_placeholder_key_envs in pyproject.toml, not here.
{% else %}
# Core's plugin keeps the default run offline (ADR-0013), runs anyio tests on asyncio and
# serves the family check in tests/test_family.py.
{% endif %}
pytest_plugins = ["xippios.core.testing.plugin"]
{% if tenant_param %}

# Once, when pytest imports this file, before any fixture of any scope: core removes
# {{ tenant_list_var }} and every {{ tenant_param }}'s key but the reserved demo's, which the live tests
# read, so no test sees another {{ tenant_param }} (conventions §7; ADR-0042, decision 1).
keep_reserved_tenants(TENANTS)
{% endif %}
