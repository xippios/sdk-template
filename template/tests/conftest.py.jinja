{% if tenant_param %}
from xippios.core.testing import keep_reserved_tenants

from xippios.{{ import_path }}._client import TENANTS

{% endif %}
{% if shape == 'general' %}
# Core's plugin keeps the default run offline (sdk-core ADR-0035) and runs anyio tests on
# asyncio.
{% elif key_envs or (tenant_param and not api_key_env and live_secret_names) %}
# Core's plugin keeps the default run offline and free of real keys (sdk-core ADR-0035),
# runs anyio tests on asyncio and serves the family check in tests/test_family.py; it reads
# a key's variable from ENV_VARS in _client.py, not from here.
{% else %}
# Core's plugin keeps the default run offline (sdk-core ADR-0035), runs anyio tests on
# asyncio and serves the family check in tests/test_family.py.
{% endif %}
pytest_plugins = ["xippios.core.testing.plugin"]
{% if tenant_param %}

# Once, when pytest imports this file, before any fixture of any scope: core removes the
# tenant list and every tenant's variables but the reserved demo's, which the live tests
# read, so no test sees another tenant (conventions §7; sdk-core ADR-0042, decision 1).
keep_reserved_tenants(TENANTS)
{% endif %}
