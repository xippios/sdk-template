"""The write path: each write task confirm-gated, confirm last and documented.

Conventions §8: write tools live on a server of their own, behind the entry point
``xippios-{{ source_slug }}-mcp-write``; each takes ``confirm: bool = False`` and previews
unless it is true. That the write server serves exactly the write tasks, each with
``confirm: bool = False``, and that the read server and the HTTP router serve none is
core's family check, ``test_family_write_server_serves_the_write_tasks``, which
``tests/test_family.py`` collects. An ``async_fn`` is not required: conventions §6 makes
the async variant optional. Per-task replay tests go below.
"""

import inspect
import re
from collections.abc import Callable

import pytest

from xippios.{{ source_pkg }} import tasks_write

WRITE_TASKS: dict[str, Callable[..., object]] = {
    name: getattr(tasks_write, name) for name in tasks_write.__all__
}


@pytest.mark.parametrize("task", list(WRITE_TASKS.values()), ids=list(WRITE_TASKS))
def test_write_task_takes_confirm_last_and_documents_it(task: Callable[..., object]) -> None:
    """What the family check leaves out: confirm's place and its line under Args:."""
    assert list(inspect.signature(task).parameters)[-1:] == ["confirm"], "confirm comes last"
    doc = inspect.getdoc(task) or ""
    assert re.search(r"^\s+confirm:", doc, re.MULTILINE), "explain confirm under Args:"
