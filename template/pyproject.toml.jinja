[project]
name = "xippios-{{ source_slug }}"
version = "0.1.0"
description = "Typed client, MCP tools and HTTP routes for {{ source_name }}"
readme = "README.md"
license = "Apache-2.0"
license-files = ["LICENSE"]
requires-python = ">=3.12"
authors = [{ name = "XIPPIOS GmbH" }]
keywords = ["sdk", "{{ source_slug }}", "{{ domain_topic }}", "mcp", "httpx", "pydantic"]
classifiers = [
  "Development Status :: 3 - Alpha",
  "Intended Audience :: Developers",
  "Programming Language :: Python :: 3",
  "Programming Language :: Python :: 3.12",
  "Programming Language :: Python :: 3.13",
  "Programming Language :: Python :: 3.14",
  "Typing :: Typed",
]
dependencies = [
  "xippios-core>=0.1.0",
]

[project.optional-dependencies]
mcp = ["xippios-core[mcp]>=0.1.0"]
http = ["xippios-core[http]>=0.1.0"]
testing = ["xippios-core[testing]>=0.1.0"]

[project.scripts]
xippios-{{ source_slug }}-mcp = "xippios.{{ source_pkg }}.mcp:run"
{% if needs_write_tools %}
xippios-{{ source_slug }}-mcp-write = "xippios.{{ source_pkg }}.mcp_write:run"
{% endif %}

[project.urls]
Homepage = "https://github.com/xippios/sdk-{{ source_slug }}"
Upstream = "{{ upstream_url }}"
Changelog = "https://github.com/xippios/sdk-{{ source_slug }}/blob/main/CHANGELOG.md"
Issues = "https://github.com/xippios/sdk-{{ source_slug }}/issues"

[dependency-groups]
dev = [
  "ruff>=0.14",
  "mypy>=1.18",
  "pre-commit>=4",
  "pytest>=8",
  "respx>=0.22",
  "anyio>=4",
  "detect-secrets>=1.5",
]
{% if core_git_ref %}

[tool.uv.sources]
# Development only: xippios-core from git until it is on PyPI. Remove this block
# (re-run copier with core_git_ref="") once the published package is available.
xippios-core = { git = "https://github.com/xippios/sdk-core.git", rev = "{{ core_git_ref }}" }
{% endif %}

[build-system]
requires = ["hatchling>=1.27"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/xippios"]

[tool.hatch.build.targets.sdist]
include = ["src", "tests", "docs", "README.md", "CHANGELOG.md", "LICENSE"]

[tool.ruff]
line-length = 100
target-version = "py312"
src = ["src", "tests"]
extend-exclude = ["docs", ".claude"]

[tool.ruff.lint]
select = ["E", "W", "F", "I", "UP", "B", "SIM", "RUF", "D", "ANN", "PTH", "PT", "T20", "C4"]
ignore = [
  "ANN401", # Any is allowed where upstream payloads are untyped by nature
  "D105",   # magic methods need no docstring
  "D107",   # __init__ is documented on the class
]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ruff.lint.isort]
known-first-party = ["xippios.{{ source_pkg }}"]
known-third-party = ["xippios.core"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["D", "ANN"]

[tool.ruff.format]
quote-style = "double"

[tool.mypy]
strict = true
python_version = "3.12"
plugins = ["pydantic.mypy"]
files = ["src", "tests"]
mypy_path = "src"
namespace_packages = true
explicit_package_bases = true
warn_unreachable = true

[tool.pytest.ini_options]
addopts = "-ra --strict-markers --import-mode=importlib"
testpaths = ["tests"]
