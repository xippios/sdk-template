{% if tenant_param %}
{% set credential = 'key' if api_key_env else 'credential' %}
"""One configured ``AsyncClient`` per tenant, and the error mapping (conventions §6, §7).

A multi-tenant source: every task takes ``{{ tenant_param }}``, the name of one tenant the
environment declares, and ``client_for`` returns that tenant's own client, with its own
{{ credential }} and its own rate limiter. The registry is core's ``Tenants``, ``TENANTS`` below:

- ``{{ tenant_list_var }}`` lists the names, comma-separated,
  each matching ``^[a-z0-9_]+$``;
- per name, ``{{ tenant_credential_env }}``, the name upper-cased;
- the reserved tenant ``demo`` is never listed: it exists when
  ``{{ tenant_prefix }}_DEMO_{{ tenant_field }}`` is set. Fixtures, live tests and the fixture recorder
  use it and nothing else.
"""
{% else %}
"""The package's one configured ``AsyncClient`` and its error mapping (conventions §6)."""
{% endif %}

import httpx
{% set names = ['AsyncClient', 'ClientConfig', 'EnvVar', 'RateLimit', 'XippiosError'] %}
{% if gateway == 'api.data.gov' %}
{% elif api_key_env and api_key_location == 'query' %}
{% set names = names + ['QueryKeyAuth'] %}
{% elif api_key_env and api_key_location == 'header' %}
{% set names = names + ['HeaderKeyAuth'] %}
{% elif api_key_env and api_key_location == 'bearer' %}
{% set names = names + ['BearerAuth'] %}
{% elif api_key_env and api_key_location == 'basic' %}
{% set names = names + ['BasicKeyAuth'] %}
{% endif %}
{% if tenant_param %}
{% set names = names + ['Tenants'] %}
{% endif %}
{% set line = 'from xippios.core import ' ~ (names | sort | join(', ')) %}
{% if line | length <= 100 %}
{{ line }}
{% else %}
from xippios.core import (
{% for name in names | sort %}
    {{ name }},
{% endfor %}
)
{% endif %}
{% if gateway == 'api.data.gov' %}
from xippios.core.data_gov import Gateway
{% endif %}

from xippios.{{ import_path }}._version import __version__

SOURCE = "{{ source_slug }}"
BASE_URL = "{{ api_base_url }}"
{% if tenant_param %}
DEMO = "demo"
"""The reserved tenant, declared by its own {{ credential }} alone and never listed."""
{% elif api_key_env %}
API_KEY_ENV = "{{ api_key_env }}"  # pragma: allowlist secret (a variable name, not a key)
{% else %}
API_KEY_ENV: str | None = None
{% endif %}
{% set ns = namespace(entries=[]) %}
{% for var in env_vars %}
{% if var.name == api_key_env and not tenant_param %}
{% set ns.entries = ns.entries + ['EnvVar(API_KEY_ENV, secret=True, required=True)'] %}
{% else %}
{% set ns.entries = ns.entries + ['EnvVar("' ~ var.name ~ '", secret=' ~ var.secret ~ ', required=' ~ var.required ~ ')'] %}
{% endif %}
{% endfor %}
{% set one = 'ENV_VARS: tuple[EnvVar, ...] = (' ~ (ns.entries | first) ~ ',)' if ns.entries | length == 1 else '' %}
{% if one and one | length <= 100 %}
{{ one }}
{% elif ns.entries %}
ENV_VARS: tuple[EnvVar, ...] = (
{% for entry in ns.entries %}
    {{ entry }},
{% endfor %}
)
{% else %}
ENV_VARS: tuple[EnvVar, ...] = ()
{% endif %}
"""The variables the package reads, for a host (conventions §7; ADR-0026, amendment 2026-11-18,
point c). An ``EnvVar`` names a variable and reads none; a variable the source reads beside
these joins the list."""
{% if rate_limit_provenance == 'self-imposed' %}
# A self-imposed pace: upstream documents no per-second or per-minute limit (ADR-0010 decision 1).
{% elif rate_limit_provenance == 'below-documented' %}
# Paced under the limit upstream documents; CLAUDE.md gives both (ADR-0010 decision 1).
{% else %}
# Paced within the limit upstream documents (ADR-0010 decision 1).
{% endif %}
RATE_LIMIT = RateLimit(per_minute={{ rate_limit_per_minute }}, burst={{ rate_limit_burst }})
{% if gateway == 'api.data.gov' %}

# api.data.gov's key, its documented answers and its hourly quota, kept by one policy per
# process that every source behind the gateway shares (ADR-0009).
gateway = Gateway(SOURCE)
{% endif %}
{% if tenant_param %}

TENANTS = Tenants(
    SOURCE,
{% if tenant_prefix != (source_slug | upper | replace('-', '_')) %}
    var_prefix="{{ tenant_prefix }}",
{% endif %}
    list_var="{{ tenant_list_var }}",
    param="{{ tenant_param }}",
    fields=("{{ tenant_field }}",),
    reserved=(DEMO,),
)
"""The tenants the environment declares (conventions §7; ADR-0036)."""
{% endif %}


def classify(response: httpx.Response) -> XippiosError | None:
    """Upstream's documented error shapes as taxonomy errors, else ``None`` (conventions §6).

    The ``ClientConfig.classify`` hook: it sees every response before core's status mapping.
{% if gateway == 'api.data.gov' %}
    The gateway's answers come first, mapped by ``gateway.classify``; the source's follow.
{% endif %}
    """
{% if gateway == 'api.data.gov' %}
    error = gateway.classify(response)
    if error is not None:
        return error
{% endif %}
    return None


{% if gateway == 'api.data.gov' %}
config = gateway.install(
    ClientConfig(
        source=SOURCE,
        version=__version__,
        base_url=BASE_URL,
        rate_limit=RATE_LIMIT,
        classify=classify,
    )
)
{% else %}
config = ClientConfig(
    source=SOURCE,
    version=__version__,
    base_url=BASE_URL,
    rate_limit=RATE_LIMIT,
    classify=classify,
)

# A source with a documented hourly or daily quota installs a QuotaPolicy of its own on
# config (conventions §6, ADR-0015); core's README shows how.
{% endif %}

{% if tenant_param and api_key_env %}
{% if api_key_location == 'query' %}
{% set auth_call = 'QueryKeyAuth("' ~ api_key_name ~ '", TENANTS.var(name, "API_KEY"), source=SOURCE)' %}
{% elif api_key_location == 'header' %}
{% set auth_call = 'HeaderKeyAuth("' ~ api_key_name ~ '", TENANTS.var(name, "API_KEY"), source=SOURCE)' %}
{% elif api_key_location == 'bearer' %}
{% set auth_call = 'BearerAuth(TENANTS.var(name, "API_KEY"), source=SOURCE)' %}
{% else %}
{% set auth_call = 'BasicKeyAuth(TENANTS.var(name, "API_KEY"), source=SOURCE)' %}
{% endif %}

def _build(name: str) -> AsyncClient:
    """Tenant ``name``'s own client, its key read from the environment on its first request.

    Every tenant's client has its own rate limiter; ``config`` holds no cache, so the
    clients share settings alone.
    """
    auth = {{ auth_call }}
    return AsyncClient(config, auth=auth)
{% endif %}
{% if tenant_param and not api_key_env %}

def _build(name: str) -> AsyncClient:
    """Tenant ``name``'s own client, with the auth that reads its credential.

    Every tenant's client has its own rate limiter; ``config`` holds no cache, so the
    clients share settings alone.
    """
    # The source's own auth reads the tenant's credential on the first request, a subclass
    # of core's RenewingBearerAuth where upstream exchanges it for a bearer (conventions
    # §7), and is passed here, for example:
    #
    # auth = TenantAuth(TENANTS.var(name, "{{ tenant_field }}"), source=SOURCE)
    # return AsyncClient(config, auth=auth)
    return AsyncClient(config)
{% endif %}
{% if tenant_param %}


def client_for({{ tenant_param }}: str) -> AsyncClient:
    """The client of a declared tenant, built on its first use and kept.

    Raises:
        InvalidRequestError: The tenant is not declared; the message names the declared ones.
    """
    return TENANTS.client_for({{ tenant_param }}, _build)


def check_{{ tenant_param }}({{ tenant_param }}: str) -> None:
    """Check a declared tenant at the startup of a server bound to it, before it is built.

    Core's ``serve_tenants`` calls it after ``TENANTS.require``, so a bound server whose
    tenant has no {{ credential }} stops at startup rather than on its first call.

    Raises:
        ConfigError: ``{{ tenant_credential_env }}`` is not set; the message names the
            variable, never a value.
    """
    TENANTS.field({{ tenant_param }}, "{{ tenant_field }}")

{% elif api_key_env %}
# The key is read from the environment on the first request, never at import.
{% if gateway == 'api.data.gov' %}
auth = gateway.auth
{% elif api_key_location == 'query' %}
auth = QueryKeyAuth("{{ api_key_name }}", API_KEY_ENV, source=SOURCE)
{% elif api_key_location == 'header' %}
auth = HeaderKeyAuth("{{ api_key_name }}", API_KEY_ENV, source=SOURCE)
{% elif api_key_location == 'bearer' %}
auth = BearerAuth(API_KEY_ENV, source=SOURCE)
{% elif api_key_location == 'basic' %}
auth = BasicKeyAuth(API_KEY_ENV, source=SOURCE)
{% endif %}
client = AsyncClient(config, auth=auth)
{% else %}
client = AsyncClient(config)
{% endif %}

__all__ = [
{% if not tenant_param %}
    "API_KEY_ENV",
{% endif %}
    "BASE_URL",
{% if tenant_param %}
    "DEMO",
{% endif %}
    "ENV_VARS",
    "RATE_LIMIT",
    "SOURCE",
{% if tenant_param %}
    "TENANTS",
{% elif api_key_env %}
    "auth",
{% endif %}
{% if tenant_param %}
    "check_{{ tenant_param }}",
{% endif %}
    "classify",
{% if tenant_param %}
    "client_for",
{% else %}
    "client",
{% endif %}
    "config",
{% if gateway == 'api.data.gov' %}
    "gateway",
{% endif %}
]
