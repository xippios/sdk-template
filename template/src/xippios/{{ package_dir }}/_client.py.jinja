{% if tenant_param %}
"""One configured ``AsyncClient`` per tenant, and the error mapping (conventions §6, §7).

A multi-tenant source: every task takes ``{{ tenant_param }}``, the name of one tenant the
environment declares, and ``client_for`` returns that tenant's own client, with its own
key and its own rate limiter. The registry is core's ``Tenants``, ``TENANTS`` below:

- ``{{ tenant_list_var }}`` lists the names, comma-separated,
  each matching ``^[a-z0-9_]+$``;
- per name, ``{{ tenant_prefix }}_<NAME>_{{ tenant_field }}``, the name upper-cased;
- the reserved tenant ``demo`` is never listed: it exists when
  ``{{ tenant_prefix }}_DEMO_{{ tenant_field }}`` is set. Fixtures, live tests and the fixture recorder
  use it and nothing else.
"""
{% else %}
"""The package's one configured ``AsyncClient`` and its error mapping (conventions §6)."""
{% endif %}

import httpx
{% set names = ['AsyncClient', 'ClientConfig', 'EnvVar', 'RateLimit', 'XippiosError'] %}
{% if tenant_param %}
{% set names = names + ['Tenants'] %}
{% endif %}
{% set line = 'from xippios.core import ' ~ (names | sort | join(', ')) %}
{% if line | length <= 100 %}
{{ line }}
{% else %}
from xippios.core import (
{% for name in names | sort %}
    {{ name }},
{% endfor %}
)
{% endif %}

from xippios.{{ import_path }}._version import __version__

SOURCE = "{{ source_slug }}"
BASE_URL = "https://example.invalid"
"""The URL that request paths join onto, usually not the provider page: the source's first pull
request sets it from upstream's documentation, in place of this host that never resolves."""
{% if tenant_param %}
DEMO = "demo"
"""The reserved tenant, declared by its own key alone and never listed."""
{% elif api_key_env %}
API_KEY_ENV = "{{ api_key_env }}"  # pragma: allowlist secret (a variable name, not a key)
{% endif %}
{% set ns = namespace(entries=[]) %}
{% for var in env_vars %}
{% if var.name == api_key_env and not tenant_param %}
{% set ns.entries = ns.entries + ['EnvVar(API_KEY_ENV, secret=True, required=True)'] %}
{% else %}
{% set ns.entries = ns.entries + ['EnvVar("' ~ var.name ~ '", secret=' ~ var.secret ~ ', required=' ~ var.required ~ ')'] %}
{% endif %}
{% endfor %}
{% set one = 'ENV_VARS: tuple[EnvVar, ...] = (' ~ (ns.entries | first) ~ ',)' if ns.entries | length == 1 else '' %}
{% if one and one | length <= 100 %}
{{ one }}
{% elif ns.entries %}
ENV_VARS: tuple[EnvVar, ...] = (
{% for entry in ns.entries %}
    {{ entry }},
{% endfor %}
)
{% else %}
ENV_VARS: tuple[EnvVar, ...] = ()
{% endif %}
"""The variables the package reads, for a host (conventions §7; sdk-core ADR-0026, amendment
2026-11-18, point c). An ``EnvVar`` names a variable and reads none; a variable the source reads
beside these joins the list."""
RATE_LIMIT = RateLimit(per_minute=60, burst=1)
"""The pace, enforced client-side: the source's first pull request sets it from upstream's
documentation, within its per-second or per-minute limit, under it on evidence or, where it
documents neither, self-imposed, with a burst of 1 unless upstream documents one, and says
which here and in CLAUDE.md (sdk-core ADR-0033 decision 1)."""
{% if tenant_param %}

TENANTS = Tenants(
    SOURCE,
{% if tenant_prefix != (source_slug | upper | replace('-', '_')) %}
    var_prefix="{{ tenant_prefix }}",
{% endif %}
    list_var="{{ tenant_list_var }}",
    param="{{ tenant_param }}",
    fields=("{{ tenant_field }}",),
    reserved=(DEMO,),
)
"""The tenants the environment declares (conventions §7; sdk-core ADR-0036)."""
{% endif %}


def classify(response: httpx.Response) -> XippiosError | None:
    """Upstream's documented error shapes as taxonomy errors, else ``None`` (conventions §6).

    The ``ClientConfig.classify`` hook: it sees every response before core's status mapping.
    """
    return None


config = ClientConfig(
    source=SOURCE,
    version=__version__,
    base_url=BASE_URL,
    rate_limit=RATE_LIMIT,
    classify=classify,
)

# A source with a documented hourly or daily quota installs a QuotaPolicy of its own on
# config (conventions §6, sdk-core ADR-0037); core's README shows how.

{% if tenant_param %}

def _build(name: str) -> AsyncClient:
    """Tenant ``name``'s own client, with the auth that reads its key.

    Every tenant's client has its own rate limiter; ``config`` holds no cache, so the
    clients share settings alone.
    """
    # The source's first pull request passes the auth that upstream documents, core's
    # QueryKeyAuth, HeaderKeyAuth, BearerAuth or BasicKeyAuth on the tenant's key, which it
    # reads on the first request, never at import (conventions §6, §7), for example:
    #
    # auth = BasicKeyAuth(TENANTS.var(name, "API_KEY"), source=SOURCE)
    # return AsyncClient(config, auth=auth)
    return AsyncClient(config)
{% endif %}
{% if tenant_param %}


def client_for({{ tenant_param }}: str) -> AsyncClient:
    """The client of a declared tenant, built on its first use and kept.

    Raises:
        InvalidRequestError: The tenant is not declared; the message names the declared ones.
    """
    return TENANTS.client_for({{ tenant_param }}, _build)


def check_{{ tenant_param }}({{ tenant_param }}: str) -> None:
    """Check a declared tenant at the startup of a server bound to it, before it is built.

    Core's ``serve_tenants`` calls it after ``TENANTS.require``, so a bound server whose
    tenant has no key stops at startup rather than on its first call.

    Raises:
        ConfigError: ``{{ tenant_prefix }}_<NAME>_{{ tenant_field }}`` is not set; the message names the
            variable, never a value.
    """
    TENANTS.field({{ tenant_param }}, "{{ tenant_field }}")

{% elif api_key_env %}
# The source's first pull request passes the auth that upstream documents, core's
# QueryKeyAuth, HeaderKeyAuth, BearerAuth or BasicKeyAuth on API_KEY_ENV, which it reads on
# the first request, never at import (conventions §6), and exports it, for example:
#
# auth = QueryKeyAuth("<parameter>", API_KEY_ENV, source=SOURCE)
# client = AsyncClient(config, auth=auth)
client = AsyncClient(config)
{% else %}
client = AsyncClient(config)
{% endif %}

__all__ = [
{% if api_key_env and not tenant_param %}
    "API_KEY_ENV",
{% endif %}
    "BASE_URL",
{% if tenant_param %}
    "DEMO",
{% endif %}
    "ENV_VARS",
    "RATE_LIMIT",
    "SOURCE",
{% if tenant_param %}
    "TENANTS",
{% endif %}
{% if tenant_param %}
    "check_{{ tenant_param }}",
{% endif %}
    "classify",
{% if tenant_param %}
    "client_for",
{% else %}
    "client",
{% endif %}
    "config",
]
