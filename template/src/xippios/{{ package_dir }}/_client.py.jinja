"""The package's one configured ``AsyncClient`` and its error mapping (conventions §6)."""

import httpx
{% if api_key_env %}
{% if api_key_location == 'query' %}
from xippios.core import AsyncClient, ClientConfig, QueryKeyAuth, RateLimit, XippiosError
{% elif api_key_location == 'header' %}
from xippios.core import AsyncClient, ClientConfig, HeaderKeyAuth, RateLimit, XippiosError
{% elif api_key_location == 'bearer' %}
from xippios.core import AsyncClient, BearerAuth, ClientConfig, RateLimit, XippiosError
{% endif %}
{% else %}
from xippios.core import AsyncClient, ClientConfig, RateLimit, XippiosError
{% endif %}

from xippios.{{ source_pkg }}._version import __version__

SOURCE = "{{ source_slug }}"
BASE_URL = "{{ api_base_url }}"
{% if api_key_env %}
API_KEY_ENV = "{{ api_key_env }}"  # pragma: allowlist secret (a variable name, not a key)
{% else %}
API_KEY_ENV: str | None = None
{% endif %}
{% if rate_limit_provenance == 'self-imposed' %}
# A self-imposed pace: upstream documents no limit (ADR-0010 decision 1).
{% else %}
# Paced within the limit upstream documents (ADR-0010 decision 1).
{% endif %}
RATE_LIMIT = RateLimit(per_minute={{ rate_limit_per_minute }}, burst={{ rate_limit_burst }})


def classify(response: httpx.Response) -> XippiosError | None:
    """Upstream's documented error shapes as taxonomy errors, else ``None`` (conventions §6).

    The ``ClientConfig.classify`` hook: it sees every response before core's status mapping.
    """
    return None


config = ClientConfig(
    source=SOURCE,
    version=__version__,
    base_url=BASE_URL,
    rate_limit=RATE_LIMIT,
    classify=classify,
)

# An upstream that reports an hourly or daily quota installs one QuotaPolicy, from
# xippios.core, on config (conventions §6, ADR-0015); a source without one adds nothing:
#
# policy = QuotaPolicy(
#     window=3600.0,
#     limit_header="x-ratelimit-limit",
#     remaining_header="x-ratelimit-remaining",
#     source=SOURCE,
# )
# config = policy.install(config)

{% if api_key_env %}
# The key is read from the environment on the first request, never at import.
{% if api_key_location == 'query' %}
auth = QueryKeyAuth("{{ api_key_name }}", API_KEY_ENV, source=SOURCE)
{% elif api_key_location == 'header' %}
auth = HeaderKeyAuth("{{ api_key_name }}", API_KEY_ENV, source=SOURCE)
{% elif api_key_location == 'bearer' %}
auth = BearerAuth(API_KEY_ENV, source=SOURCE)
{% endif %}
client = AsyncClient(config, auth=auth)
{% else %}
client = AsyncClient(config)
{% endif %}

__all__ = [
    "API_KEY_ENV",
    "BASE_URL",
    "RATE_LIMIT",
    "SOURCE",
{% if api_key_env %}
    "auth",
{% endif %}
    "classify",
    "client",
    "config",
]
