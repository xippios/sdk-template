the server holds beside its tools (conventions §8, sdk-core ADR-0063, decision 7).
"""
{% if tenant_param %}

from xippios.core import list_task

from xippios.{{ import_path }}._client import TENANTS

__all__: list[str] = ["list_{{ tenant_param }}s"]
{% else %}

__all__: list[str] = []
{% endif %}

