"""MCP server for {{ source_name }}.

Every task in ``tasks.__all__`` is a read-only tool. No logic lives here (ADR-0001).
Entry point: ``xippios-{{ source_slug }}-mcp``.
"""

from xippios.core.mcp import build_server, main

from xippios.{{ source_pkg }} import tasks
from xippios.{{ source_pkg }}._client import SOURCE
from xippios.{{ source_pkg }}._version import __version__

INSTRUCTIONS = (
    "{{ source_name }} via xippios. "
    "Tools are read-only. Where list tools ({{ tool_prefix }}_list_*) exist, "
    "call them first to find valid values, then query."
)

server = build_server(
    SOURCE,
    [getattr(tasks, name) for name in tasks.__all__],
    version=__version__,
    instructions=INSTRUCTIONS,
    caps=getattr(tasks, "MCP_CAPS", None),
)


def run() -> None:
    """Run the server: stdio by default, ``--http`` for streamable HTTP."""
    main(server)
