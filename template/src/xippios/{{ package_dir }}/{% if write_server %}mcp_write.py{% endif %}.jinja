"""Write server for {{ source_name }}.

``tasks_write.__all__`` as confirm-gated tools, behind an entry point of their own,
``xippios-{{ source_slug }}-mcp-write``, so a client of the read server never sees a write
tool (conventions §8). Core registers them as a write server (``read_only=False``): every task
takes ``confirm: bool = False``, checked before anything is registered, and ``--http``
serves on a loopback ``--host`` only, unless ``--allow-remote`` is passed, since it
carries no authentication. No logic lives here (sdk-core ADR-0001).
{% if tenant_param %}
``--{{ tenant_param | replace('_', '-') }} <name>`` binds it to one tenant (core's ``serve_tenants``).
{% endif %}

The package contract (conventions §8; sdk-core ADR-0026, amendment 2026-11-18, points c and d):
``build()`` returns the write tool set, with the caps and the option hooks
``tasks_write.py`` defines, and ``server`` is built from it.
"""

{% if tenant_param %}
from xippios.core import TenantLock, bind_tasks, tenant_instructions
from xippios.core.mcp import ToolSet, build_server, serve_tenants, tool_functions

from xippios.{{ import_path }} import tasks_write
{% set line = 'from xippios.' ~ import_path ~ '._client import ENV_VARS, SOURCE, TENANTS, check_' ~ tenant_param %}
{% if line | length <= 100 %}
{{ line }}
{% else %}
from xippios.{{ import_path }}._client import (
    ENV_VARS,
    SOURCE,
    TENANTS,
    check_{{ tenant_param }},
)
{% endif %}
{% else %}
from xippios.core.mcp import ToolSet, build_server, main, tool_functions

from xippios.{{ import_path }} import tasks_write
from xippios.{{ import_path }}._client import ENV_VARS, SOURCE
{% endif %}
from xippios.{{ import_path }}._version import __version__

__all__ = ["ENV_VARS", "SOURCE", "build", "run", "server"]

INSTRUCTIONS = (
    "{{ source_name }} write tools via xippios. "
{% if tenant_param %}
    "Every tool takes {{ tenant_param }}, the name of a declared tenant. "
{% endif %}
    "Every tool returns a preview and changes nothing unless confirm=true is passed. "
    "Call it once without confirm, show the preview, then confirm."
)
{% if tenant_param %}
BOUND_INSTRUCTIONS = (
    "{{ source_name }} write tools via xippios. "
    "Every tool returns a preview and changes nothing unless confirm=true is passed. "
    "Call it once without confirm, show the preview, then confirm."
)
"""The text of a server ``lock`` binds, whose tools take no tenant: core's sentence names it."""
{% endif %}


{% if tenant_param %}
def build(lock: TenantLock | None = None) -> ToolSet:
    """The write tool set, bound to one tenant when ``lock`` is given."""
    return ToolSet(
        SOURCE,
        bind_tasks(tool_functions(tasks_write), lock),
        caps=getattr(tasks_write, "MCP_CAPS", None),
        instructions=tenant_instructions(INSTRUCTIONS, lock, bound=BOUND_INSTRUCTIONS),
        version=__version__,
        add_options=getattr(tasks_write, "mcp_add_options", None),
        apply_options=getattr(tasks_write, "mcp_apply_options", None),
        read_only=False,
    )
{% else %}
def build() -> ToolSet:
    """The write tool set: the write tasks with their caps, text, version and option hooks."""
    return ToolSet(
        SOURCE,
        tool_functions(tasks_write),
        caps=getattr(tasks_write, "MCP_CAPS", None),
        instructions=INSTRUCTIONS,
        version=__version__,
        add_options=getattr(tasks_write, "mcp_add_options", None),
        apply_options=getattr(tasks_write, "mcp_apply_options", None),
        read_only=False,
    )
{% endif %}


server = build_server(build())


def run() -> None:
{% if tenant_param %}
    """Run the write server: stdio by default, ``--http`` on loopback.

    ``--{{ tenant_param | replace('_', '-') }} <name>`` binds it to one tenant.
    """
    serve_tenants(server, build, TENANTS, check=check_{{ tenant_param }})
{% else %}
    """Run the write server: stdio by default, ``--http`` on loopback, the source's options."""
    tools = build()
    main(server, add_options=tools.add_options, apply_options=tools.apply_options)
{% endif %}
