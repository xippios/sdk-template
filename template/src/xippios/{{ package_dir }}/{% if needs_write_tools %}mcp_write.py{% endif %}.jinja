"""Write server for {{ source_name }}: ``tasks_write.__all__`` as confirm-gated tools.

A separate entry point, ``xippios-{{ source_slug }}-mcp-write``, so read-only clients never
see write tools (conventions §8). No logic lives here (ADR-0001).
"""

from xippios.core.mcp import build_server, main

from xippios.{{ source_pkg }} import tasks_write
from xippios.{{ source_pkg }}._client import SOURCE
from xippios.{{ source_pkg }}._version import __version__

INSTRUCTIONS = (
    "{{ source_name }} write tools via xippios. Every tool returns a preview unless "
    "confirm=true is passed. Call it once without confirm, show the preview, then confirm."
)

server = build_server(
    SOURCE,
    [getattr(tasks_write, name) for name in tasks_write.__all__],
    name="xippios-{{ source_slug }}-write",
    version=__version__,
    instructions=INSTRUCTIONS,
    read_only=False,
)


def run() -> None:
    """Run the write server: stdio by default, ``--http`` for streamable HTTP."""
    main(server)
